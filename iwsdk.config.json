{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/desk.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "referenceSpace": {
        "type": "local-floor",
        "fallbackOrder": [
          "local-floor",
          "local"
        ]
      },
      "features": {
        "handTracking": true,
        "anchors": {
          "required": false
        },
        "planeDetection": {
          "required": false
        },
        "meshDetection": {
          "required": false
        },
        "hitTest": false
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "near": 0.01,
      "far": 50,
      "camera": {
        "position": [
          0,
          1.4,
          0.6
        ],
        "lookAt": [
          0,
          0.9,
          -1
        ]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": true,
      "physics": false,
      "sceneUnderstanding": {
        "showWireFrame": false
      },
      "environmentRaycast": false,
      "spatialUI": false
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "injectOnBuild": true,
      "environment": "office_small",
      "activation": {
        "source": "^(localhost|127\\.0\\.0\\.1|.*\\.github\\.io)$"
      }
    }
  }
}
